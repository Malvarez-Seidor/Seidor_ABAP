@Metadata.layer: #CORE

@UI :{ headerInfo : { typeName          : 'Detalle de Retención',
                      typeNamePlural    : 'Detalles de Retenciones',
                      title             : { type :#STANDARD, value : 'BillingDocument' },
                      description       : { type :#STANDARD, value : 'BillingDocumentItem' } },
                      
 presentationVariant: [ { sortOrder: [ { by: 'BillingDocumentItem', direction:  #ASC } ],
                     visualizations: [ { type: #AS_LINEITEM } ] } ] }
                     
annotate entity ZCDS_VC_DET_VEN with
{
    
    @UI.facet: [ { id : 'Detail', purpose : #STANDARD, type : #IDENTIFICATION_REFERENCE, label : 'Detalle', position: 10 } ]
    
    @UI: { lineItem: [ { position : 10, importance : #HIGH, cssDefault.width: '4rem' } ],
     identification: [ { position : 10 } ] }
    BillingDocumentItem;
    
    @UI: { lineItem: [ { position : 20, importance : #HIGH, cssDefault.width: '20rem' } ],
     identification: [ { position : 20 } ] }
    Product;
    
    @UI: { lineItem: [ { position : 40, importance : #HIGH, cssDefault.width: '10rem' } ],
     identification: [ { position : 40 } ] }
    BillingQuantity;
    
    @UI: { lineItem: [ { position : 50, label : 'Importe Neto', importance : #HIGH, cssDefault.width: '10rem' } ],
     identification: [ { position : 50, label : 'Importe Neto' } ] }
    NetAmount;
    
    @UI: { lineItem: [ { position : 60, importance : #HIGH, cssDefault.width: '5rem' } ],
     identification: [ { position : 60 } ] }
    TaxCode;
    
    @UI: { lineItem: [ { position : 70, importance : #HIGH, label : 'Porcentaje', cssDefault.width: '5rem' } ],
     identification: [ { position : 70, label : 'Porcentaje' } ] }
    taxratepercent;
    
    @UI: { lineItem: [ { position : 80, label : 'Impuesto', importance : #HIGH, cssDefault.width: '10rem' } ],
     identification: [ { position : 80, label : 'Impuesto' } ] }
    TaxAmount;
    
    
    @UI: { lineItem: [ { position : 90, label : 'Importe Total', importance : #HIGH, cssDefault.width: '10rem' } ],
     identification: [ { position : 90, label : 'Importe Total' } ] }
    EligibleAmountForCashDiscount;
    
    @UI: { identification: [ { position : 100 } ] }
    SalesDocument;
    
    @UI: { identification: [ { position : 110 } ] }
    SalesDocumentItem;
    
}