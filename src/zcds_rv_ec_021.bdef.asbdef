lock master
authorization master ( global, instance )
//etag master <field_name>
{

  create;
  update;
  delete;
  field ( readonly: update ) Companycode, Fiscalyear, Monat, Purchases, Sales, Export, Cancel,
                             Filename, Mimetype, Status, Criticality;
//                             , CompanyCodeName, Description, StatusXML;

  action (  authorization : update, features : instance ) Download  result [1] $self;

  mapping for zdt_ec_021{

  CompanyCode            = CompanyCode;
