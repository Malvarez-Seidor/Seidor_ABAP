@Metadata.layer: #CORE

@UI :{ headerInfo : { typeName          : 'Guía de Traslado',
                      typeNamePlural    : 'Guías de Traslados',
                      title             : { type :#STANDARD, value : 'CompanyCodeName' },
//                      imageUrl: 'Xml',
                      description       : { type :#STANDARD,  value : 'CompanyCode' } },
                      
 presentationVariant: [ { sortOrder: [ { by: 'DocumentStatus',   direction:  #DESC },
                                       { by: 'MaterialDocument', direction:  #ASC  } ],
                     visualizations: [ { type: #AS_LINEITEM } ] } ] }

 annotate view ZCDS_P_DOC_MM_GUIA with
 
{

  @UI.facet: [ { label: 'Inf. Cabecera',    purpose: #STANDARD, type: #IDENTIFICATION_REFERENCE, importance: #HIGH, position: 10 },
               { label: 'Inf. Documento',   purpose: #STANDARD, type: #FIELDGROUP_REFERENCE,     importance: #HIGH, position: 20, targetQualifier: 'Detail'   },
               { label: 'Datos Transporte', purpose: #STANDARD, type: #LINEITEM_REFERENCE,       importance: #HIGH, position: 30, targetQualifier: 'Data',
                 targetElement: '_TransportData' },
               { label: 'Adjunto',          purpose: #STANDARD, type: #FIELDGROUP_REFERENCE,     importance: #HIGH, position: 40, targetQualifier: 'Attached' },
               { label: 'Log',              purpose: #STANDARD, type: #FIELDGROUP_REFERENCE,     importance: #HIGH, position: 50, targetQualifier: 'Log'      } ]
               
  @UI: { lineItem: [ { position : 10, importance : #HIGH } ],
  textArrangement: #TEXT_ONLY }
  @Search.defaultSearchElement: true
  @Search.fuzzinessThreshold: 0.8
  CompanyCode;
  
  @UI: { lineItem: [ { position : 20, importance : #HIGH  } ], 
   selectionField: [ { position : 10 } ] }
  @UI: { dataPoint: { visualization: #NUMBER   } }
  MaterialDocument;
  
  @UI: { lineItem: [ { position : 30, importance : #MEDIUM } ],
   textArrangement: #TEXT_ONLY }
  @Search.defaultSearchElement: true
  @ Search.fuzzinessThreshold: 0.8
  GoodsMovementType;
  
  @UI: { lineItem: [ { position : 40, importance : #MEDIUM } ] }
  @UI.fieldGroup: [ { qualifier: 'Detail',position: 90 } ]
  MaterialDocumentYear;
  
  @UI: { lineItem: [ { position : 50, importance : #HIGH } ],
   selectionField: [ { position : 20 } ] }
  @UI.fieldGroup: [ { qualifier: 'Detail',position: 50 } ]
  Plant;
  
  @UI: { lineItem: [ { position : 60, label : 'Establecimiento', importance : #HIGH } ],
   identification: [ { position : 30, label : 'Establecimiento' } ],
   selectionField: [ { position: 30 } ] }
  Establishment;
  
  @UI: { lineItem: [ { position : 70, label : 'Punto Emisión', importance : #HIGH } ],
   identification: [ { position : 60, label : 'Punto Emisión' } ],
   selectionField: [ { position: 40 } ] }
  Emissionpoint;
  
  @UI: { lineItem: [ { position : 80,   label : 'Secuencial', importance : #HIGH } ],
   identification: [ { position : 100,  label : 'Secuencial' } ],
   selectionField: [ { position: 50 } ] }
  Sequential;
  
  @UI: { lineItem: [ { position : 90, label : 'Fecha Emisión', importance : #MEDIUM } ],
   identification: [ { position : 50, label : 'Fecha Emisión' } ] }
  IssueDate;
  
  @UI: { lineItem: [ { position : 100,  label : 'Estado Documento', importance : #HIGH, criticality: 'Criticality' },
                     { type: #FOR_ACTION, dataAction: 'SendDocument', label: 'Enviar Documento' },
                     { type: #FOR_ACTION, dataAction: 'UpdateStatus', label: 'Actualizar Estado' } ],
   selectionField: [ { position : 60 } ],
   identification: [ { type: #FOR_ACTION, dataAction: 'SendDocument', label: 'Enviar Documento' }, 
                     { type: #FOR_ACTION, dataAction: 'UpdateStatus', label: 'Actualizar Estado' } ] }
  
  @UI.textArrangement: #TEXT_ONLY
  @UI: { dataPoint: { title: 'Estado Documento',  criticality : 'Criticality', criticalityRepresentation: #WITH_ICON } }
  @Search.defaultSearchElement: true
  @Search.fuzzinessThreshold: 0.8
  DocumentStatus;
  
  @UI: { lineItem: [ { position : 110, label : 'Fecha Autorización', importance :  #MEDIUM } ],
   identification: [ { position : 80,  label : 'Fecha Autorización' } ] }
  AuthorizationDate;
  
  @UI: { lineItem: [ { position : 120,  importance : #MEDIUM } ],
   textArrangement: #TEXT_ONLY }
  @UI.fieldGroup: [ { qualifier: 'Detail',position: 20 } ]
  StorageLocation;
  
  @UI: { lineItem: [ { position : 130, label : 'Clave Acceso', importance : #MEDIUM } ],
   identification: [ { position : 40,  label : 'Clave Acceso' } ] }
  Accesskey;
  
  @UI: { lineItem: [ { position : 140, label : 'Tipo Documento', importance : #MEDIUM } ],
   identification: [ { position : 10,  label : 'Tipo Documento' } ],
   textArrangement: #TEXT_ONLY }
  @Search.defaultSearchElement: true
  @Search.fuzzinessThreshold: 0.8
  DocumentType;
  
  @UI: { lineItem: [ { position : 150, importance : #MEDIUM } ] }
  @UI.fieldGroup: [ { qualifier: 'Detail',position: 40 } ]
  DocumentDate;
  
  @UI: { lineItem: [ { position : 160, importance : #LOW } ] }
  @UI.fieldGroup: [ { qualifier: 'Detail', position: 60 } ]
  PostingDate;
  
  @UI: { lineItem: [ { position : 170, importance :  #MEDIUM } ],
   identification: [ { position : 70 } ] }
  GoodsMovementIsCancelled;
  
  @UI: { identification: [ { position : 90, label : 'Número Identificación' } ] }
  IdNumber;
  
  @UI: { identification: [ { position : 110,  label : 'Documento Proveedor' } ] }
  DocumentSupplier;
  
  @UI.fieldGroup: [ { qualifier: 'Detail',position: 10 } ]
  MaterialDocumentItem;
  
  @UI.fieldGroup: [ { qualifier: 'Detail',position: 30 } ]
  MaterialDocumentRecordType;
  
  @UI.fieldGroup: [ { qualifier:'Attached',  label :'Xml', position: 10 } ]
  Xml;
  
  @UI.fieldGroup: [ { qualifier: 'Log', label : 'Mensaje Documento', position: 10 } ]
  MessageDocument;
  
  @Search.defaultSearchElement: true
  @Search.fuzzinessThreshold: 0.8
  CompanyCodeName;
  
  @Search.defaultSearchElement: true
  @Search.fuzzinessThreshold: 0.8
  GoodsMovementTypeName;
  
  @Search.defaultSearchElement: true
  @Search.fuzzinessThreshold: 0.8
  PlantName;
  
  @Search.defaultSearchElement: true
  @Search.fuzzinessThreshold: 0.8
  StorageLocationName;

}