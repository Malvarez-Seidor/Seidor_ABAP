//etag master <field_name>
{

  update;
  delete;

  field ( readonly ) Companycode, Documentsri, Accesskey, Documentsupplier, Positem;

  association _ElectronicDocuments;

  mapping for zdt_ec_016{

  Companycode          = companycode;
  Documentsri          = documentsri;
  Accesskey            = accesskey;
  Documentsupplier     = documentsupplier;
  Positem              = positem;
  Establishmentsupport = establishmentsupport;
  Emissionpointsupport = emissionpointsupport;
  Sequentialsupport    = sequentialsupport;
  Accesskeysupport     = accesskeysupport;
  Documentsrisupport   = documentsrisupport;
  Officialwhldgtaxcode = officialwhldgtaxcode;
  Codeid               = codeid;
  Amountretained       = amountretained;
  Percentageretained   = percentageretained;
  Baseretained         = baseretained;
  Currency             = currency;

  }

}

define behavior for ZCDS_RV_EC_017 alias PurchaseOrders
persistent table zdt_ec_017
lock dependent by _ElectronicDocuments
authorization dependent by _ElectronicDocuments
//etag master <field_name>
{

  update;
  delete;

  field ( readonly ) Companycode, Documentsri, Accesskey, Documentsupplier, Purchasingdocument, Purchasingdocumentitem;

  association _ElectronicDocuments;

