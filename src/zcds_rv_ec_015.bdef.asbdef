  documentsri                 = documentsri;
  accesskey                   = accesskey;
  documentsupplier            = documentsupplier;
  purchasingdocument          = purchasingdocument;
  purchasingdocumentitem      = purchasingdocumentitem;
  materialdocument            = materialdocument;
